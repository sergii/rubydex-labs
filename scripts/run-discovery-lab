#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
scale="${2:-medium}"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

case "$mode" in
  A|a)
    label="A"
    profile="control"
    task_file="${repo_root}/labs/03-discovery-scaling/task.md"
    ;;
  B|b)
    label="B"
    profile="semantic"
    task_file="${repo_root}/labs/03-discovery-scaling/task-semantic-first.md"
    ;;
  *)
    echo "Usage: $0 A|B [small|medium|large]" >&2
    exit 2
    ;;
esac

case "$scale" in
  small|medium|large)
    ;;
  *)
    echo "Unknown scale: $scale" >&2
    exit 2
    ;;
esac

for command_name in bundle codex git python3; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name" >&2
    exit 1
  fi
done

run_id="$(date +%Y%m%d-%H%M%S)-$$"
run_dir="/tmp/rubydex-discovery-runs/${label}-${scale}-${run_id}"
target="/tmp/rubydex-discovery-${label}-${scale}-${run_id}"
benchmark_codex_home="/tmp/rubydex-codex-home-${label}-${scale}-${run_id}"
latest_link="/tmp/rubydex-discovery-${label}-${scale}-latest"

mkdir -p "$run_dir"
if [[ -n "${RUBYDEX_LABS_RUN_DIR_FILE:-}" ]]; then
  printf '%s\n' "$run_dir" > "$RUBYDEX_LABS_RUN_DIR_FILE"
fi

"${repo_root}/scripts/prepare-discovery-fixture" "$target" "$profile" "$scale"

cd "$target"

# Dependency setup is outside the measured Codex run.
if ! bundle check >/dev/null 2>&1; then
  echo "Installing dependencies for discovery ${label}/${scale}..."
  bundle install
fi

git init -q
git add -A
git -c user.name="Rubydex Labs" -c user.email="rubydex-labs@example.invalid" \
  commit -qm "Baseline discovery ${label}/${scale} fixture"

# Use a benchmark-only CODEX_HOME so unrelated user MCP servers, hooks, and
# malformed global config cannot affect startup, approvals, or timing.
global_codex_home="${CODEX_HOME:-${HOME}/.codex}"
rm -rf "$benchmark_codex_home"
mkdir -p "$benchmark_codex_home"

# Reuse the existing ChatGPT/Codex login without importing the user's config.
if [[ -f "${global_codex_home}/auth.json" ]]; then
  ln -s "${global_codex_home}/auth.json" "${benchmark_codex_home}/auth.json"
fi

benchmark_model="${RUBYDEX_LABS_MODEL:-gpt-5.6-luna}"
benchmark_reasoning="${RUBYDEX_LABS_REASONING:-medium}"

cat > "${benchmark_codex_home}/config.toml" <<EOF
model = "${benchmark_model}"
model_reasoning_effort = "${benchmark_reasoning}"
approval_policy = "never"
sandbox_mode = "read-only"
EOF

if [[ "$label" == "B" ]]; then
  cat >> "${benchmark_codex_home}/config.toml" <<EOF

[mcp_servers.rubydex]
command = "bundle"
args = ["exec", "rdx", "mcp"]
cwd = "${target}"
enabled = true
required = true
default_tools_approval_mode = "approve"
EOF
fi

cp "$task_file" "${run_dir}/prompt.md"
cat > "${run_dir}/metadata.txt" <<EOF
run_id: ${run_id}
condition: ${label}
profile: ${profile}
scale: ${scale}
workspace: ${target}
model: ${benchmark_model}
reasoning: ${benchmark_reasoning}
codex_home: ${benchmark_codex_home}
EOF

# Point status commands at this run. The run itself uses unique directories, so
# starting another benchmark cannot overwrite a currently running fixture.
ln -sfn "$run_dir" "$latest_link"

printf 'starting\n' > "${run_dir}/state"

nohup bash "${repo_root}/scripts/run-discovery-worker" \
  "$target" \
  "$benchmark_codex_home" \
  "${run_dir}/prompt.md" \
  "$run_dir" \
  > "${run_dir}/worker.log" \
  2>&1 \
  < /dev/null &
worker_pid=$!
printf '%s\n' "$worker_pid" > "${run_dir}/pid"

cat <<EOF

Started discovery Lab ${label}/${scale} in background.
PID: ${worker_pid}
Model: ${benchmark_model}
Reasoning: ${benchmark_reasoning}
Workspace: ${target}
Run data: ${run_dir}

You can close this terminal or keep working. No Codex TUI interaction is required.
Check progress/result with:

  bin/discovery-status ${label} ${scale}

Raw files:
  ${run_dir}/events.jsonl
  ${run_dir}/final.txt
  ${run_dir}/summary.json
  ${run_dir}/stderr.log
EOF
