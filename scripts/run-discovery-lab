#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"
scale="${2:-medium}"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

case "$mode" in
  A|a)
    label="A"
    profile="control"
    task_file="${repo_root}/labs/03-discovery-scaling/task.md"
    ;;
  B|b)
    label="B"
    profile="semantic"
    task_file="${repo_root}/labs/03-discovery-scaling/task-semantic-first.md"
    ;;
  *)
    echo "Usage: $0 A|B [small|medium|large]" >&2
    exit 2
    ;;
esac

case "$scale" in
  small|medium|large)
    ;;
  *)
    echo "Unknown scale: $scale" >&2
    exit 2
    ;;
esac

for command_name in bundle codex git python3; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name" >&2
    exit 1
  fi
done

target="/tmp/rubydex-discovery-${label}-${scale}"
"${repo_root}/scripts/prepare-discovery-fixture" "$target" "$profile" "$scale"

cd "$target"

# Dependency setup is outside the measured discovery run.
if ! bundle check >/dev/null 2>&1; then
  echo "Installing dependencies for discovery ${label}/${scale}..."
  bundle install
fi

git init -q
git add -A
git -c user.name="Rubydex Labs" -c user.email="rubydex-labs@example.invalid" \
  commit -qm "Baseline discovery ${label}/${scale} fixture"

prompt="$(cat "$task_file")"

# Use a benchmark-only CODEX_HOME so unrelated user MCP servers, hooks, and
# malformed global config cannot affect startup, approvals, or timing.
global_codex_home="${CODEX_HOME:-${HOME}/.codex}"
benchmark_codex_home="/tmp/rubydex-codex-home-${label}-${scale}"
rm -rf "$benchmark_codex_home"
mkdir -p "$benchmark_codex_home"

# Reuse the existing ChatGPT/Codex login without importing the user's config.
if [[ -f "${global_codex_home}/auth.json" ]]; then
  ln -s "${global_codex_home}/auth.json" "${benchmark_codex_home}/auth.json"
fi

benchmark_model="${RUBYDEX_LABS_MODEL:-gpt-5.6-luna}"
benchmark_reasoning="${RUBYDEX_LABS_REASONING:-medium}"

cat > "${benchmark_codex_home}/config.toml" <<EOF
model = "${benchmark_model}"
model_reasoning_effort = "${benchmark_reasoning}"
approval_policy = "never"
sandbox_mode = "read-only"
EOF

if [[ "$label" == "B" ]]; then
  cat >> "${benchmark_codex_home}/config.toml" <<EOF

[mcp_servers.rubydex]
command = "bundle"
args = ["exec", "rdx", "mcp"]
cwd = "${target}"
enabled = true
required = true
default_tools_approval_mode = "approve"
EOF
fi

cat <<EOF

Starting discovery Lab ${label}
Scale: ${scale}
Workspace: ${target}
Condition: ${profile}
Codex model: ${benchmark_model}
Codex reasoning: ${benchmark_reasoning}
Codex config: isolated benchmark CODEX_HOME

The timed run includes Codex and, for B, Rubydex MCP startup/indexing.
EOF

SECONDS=0
set +e
CODEX_HOME="$benchmark_codex_home" codex -C "$target" "$prompt"
codex_status=$?
set -e
elapsed="$SECONDS"

cat <<EOF

Discovery Lab ${label}/${scale} finished
Elapsed Codex session time: ${elapsed}s
Codex exit status: ${codex_status}
Workspace: ${target}
EOF

if [[ -n "$(git status --short)" ]]; then
  echo
  echo "WARNING: discovery task modified the fixture:"
  git status --short
fi

exit "$codex_status"
