#!/usr/bin/env bash
set -euo pipefail

scale="${1:-large}"
pair_dir="${2:?pair directory is required}"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

case "$scale" in
  small|medium|large) ;;
  *)
    echo "Unknown scale: $scale" >&2
    exit 2
    ;;
esac

mkdir -p "$pair_dir"

set_pair_state() {
  printf '%s\n' "$1" > "${pair_dir}/state"
}

launch_condition() {
  local label="$1"
  local lower
  local run_dir_file
  local launch_log

  lower="$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')"
  run_dir_file="${pair_dir}/${lower}-run-dir"
  launch_log="${pair_dir}/${lower}-launch.log"
  rm -f "$run_dir_file"

  if ! RUBYDEX_LABS_RUN_DIR_FILE="$run_dir_file" \
    bash "${repo_root}/scripts/run-discovery-lab" "$label" "$scale" \
    > "$launch_log" 2>&1; then
    return 1
  fi

  [[ -s "$run_dir_file" ]]
}

wait_for_condition() {
  local label="$1"
  local lower
  local run_dir
  local condition_state

  lower="$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')"
  run_dir="$(cat "${pair_dir}/${lower}-run-dir")"

  while true; do
    condition_state="starting"
    if [[ -f "${run_dir}/state" ]]; then
      condition_state="$(cat "${run_dir}/state")"
    fi

    case "$condition_state" in
      completed)
        return 0
        ;;
      blocked_usage)
        return 2
        ;;
      failed)
        return 1
        ;;
      starting|running)
        sleep 2
        ;;
      *)
        sleep 2
        ;;
    esac
  done
}

handle_condition_failure() {
  local label="$1"
  local wait_status="$2"

  if [[ "$wait_status" -eq 2 ]]; then
    set_pair_state "blocked_usage_${label}"
    exit 2
  fi

  set_pair_state "failed_${label}"
  exit 1
}

set_pair_state "starting_a"
if ! launch_condition A; then
  set_pair_state "failed_a_launch"
  exit 1
fi
set_pair_state "running_a"

set +e
wait_for_condition A
wait_status=$?
set -e
if [[ "$wait_status" -ne 0 ]]; then
  handle_condition_failure A "$wait_status"
fi

# Keep the two measurements sequential so they do not compete for local CPU.
set_pair_state "starting_b"
if ! launch_condition B; then
  set_pair_state "failed_b_launch"
  exit 1
fi
set_pair_state "running_b"

set +e
wait_for_condition B
wait_status=$?
set -e
if [[ "$wait_status" -ne 0 ]]; then
  handle_condition_failure B "$wait_status"
fi

set_pair_state "comparing"
python3 - "$pair_dir" "$scale" <<'PY'
import json
from pathlib import Path
import sys

pair_dir = Path(sys.argv[1])
scale = sys.argv[2]

def read_run(label):
    run_dir = Path((pair_dir / f"{label.lower()}-run-dir").read_text().strip())
    summary = json.loads((run_dir / "summary.json").read_text())
    final = (run_dir / "final.txt").read_text(errors="replace") if (run_dir / "final.txt").exists() else ""
    metadata = {}
    metadata_path = run_dir / "metadata.txt"
    if metadata_path.exists():
        for line in metadata_path.read_text().splitlines():
            if ": " in line:
                key, value = line.split(": ", 1)
                metadata[key] = value
    return run_dir, summary, final, metadata

a_dir, a, a_final, a_meta = read_run("A")
b_dir, b, b_final, b_meta = read_run("B")

expected = [
    "app/jobs/inventory/reservation_sync_job.rb:4",
    "app/jobs/inventory/reservation_sync_job.rb:8",
    "app/models/inventory/priority_reservation.rb:2",
    "app/services/inventory/allocator.rb:4",
    "app/services/inventory/allocator.rb:8",
    "app/services/orders/processor.rb:4",
    "app/services/orders/processor.rb:8",
]

def recall(final):
    found = [ref for ref in expected if ref in final]
    return len(found), found

metrics = [
    ("elapsed_seconds", lambda s: s["elapsed_seconds"]),
    ("total_tokens", lambda s: s["usage"]["total_tokens"]),
    ("input_tokens", lambda s: s["usage"]["input_tokens"]),
    ("cached_input_tokens", lambda s: s["usage"]["cached_input_tokens"]),
    ("uncached_input_tokens", lambda s: s["usage"]["uncached_input_tokens"]),
    ("output_tokens", lambda s: s["usage"]["output_tokens"]),
    ("reasoning_output_tokens", lambda s: s["usage"]["reasoning_output_tokens"]),
]

comparison = {
    "scale": scale,
    "model": a_meta.get("model"),
    "reasoning": a_meta.get("reasoning"),
    "a_run_dir": str(a_dir),
    "b_run_dir": str(b_dir),
    "a_status": a.get("status"),
    "b_status": b.get("status"),
    "a_reference_recall": recall(a_final)[0],
    "b_reference_recall": recall(b_final)[0],
    "expected_reference_count": len(expected),
    "metrics": {},
}

rows = []
for name, getter in metrics:
    av = int(getter(a))
    bv = int(getter(b))
    delta = bv - av
    pct = (delta / av * 100.0) if av else None
    comparison["metrics"][name] = {
        "a": av,
        "b": bv,
        "delta": delta,
        "percent": pct,
    }
    pct_text = "n/a" if pct is None else f"{pct:+.1f}%"
    rows.append((name, av, bv, pct_text))

(pair_dir / "comparison.json").write_text(json.dumps(comparison, indent=2) + "\n")

model = comparison["model"] or "unknown"
reasoning = comparison["reasoning"] or "unknown"
lines = [
    f"# Discovery pair comparison - {scale}",
    "",
    f"Model: `{model}`",
    f"Reasoning: `{reasoning}`",
    "Execution: sequential A -> B",
    "",
    f"Ground-truth reference recall: A {comparison['a_reference_recall']}/{len(expected)}, B {comparison['b_reference_recall']}/{len(expected)}",
    "",
    "| Metric | A - text | B - Rubydex | B vs A |",
    "| --- | ---: | ---: | ---: |",
]
for name, av, bv, pct_text in rows:
    lines.append(f"| {name} | {av:,} | {bv:,} | {pct_text} |")

lines.extend([
    "",
    "## A final answer",
    "",
    a_final.rstrip(),
    "",
    "## B final answer",
    "",
    b_final.rstrip(),
    "",
])
(pair_dir / "comparison.md").write_text("\n".join(lines))

summary_lines = [
    f"status: completed",
    f"scale: {scale}",
    f"model: {model}",
    f"reasoning: {reasoning}",
    f"reference_recall_a: {comparison['a_reference_recall']}/{len(expected)}",
    f"reference_recall_b: {comparison['b_reference_recall']}/{len(expected)}",
]
for name, av, bv, pct_text in rows:
    summary_lines.append(f"{name}: A={av} B={bv} B_vs_A={pct_text}")
(pair_dir / "summary.txt").write_text("\n".join(summary_lines) + "\n")
PY

set_pair_state "completed"
