#!/usr/bin/env bash
set -euo pipefail

label="${1:-B}"
scale="${2:-medium}"
label="$(printf '%s' "$label" | tr '[:lower:]' '[:upper:]')"

case "$label" in
  A|B) ;;
  *) echo "Usage: $0 A|B [small|medium|large]" >&2; exit 2 ;;
esac

case "$scale" in
  small|medium|large) ;;
  *) echo "Usage: $0 A|B [small|medium|large]" >&2; exit 2 ;;
esac

latest="/tmp/rubydex-discovery-${label}-${scale}-latest"

if [[ ! -e "$latest" ]]; then
  echo "No run found for ${label}/${scale}." >&2
  exit 1
fi

run_dir="$(cd "$latest" && pwd)"
state="unknown"
[[ -f "${run_dir}/state" ]] && state="$(cat "${run_dir}/state")"

echo "Run: ${run_dir}"
echo "State: ${state}"

if [[ "$state" == "running" && -f "${run_dir}/pid" ]]; then
  pid="$(cat "${run_dir}/pid")"
  if kill -0 "$pid" >/dev/null 2>&1; then
    echo "PID: ${pid} (running)"
  else
    echo "PID: ${pid} (not running; worker may have exited unexpectedly)"
  fi
fi

if [[ -f "${run_dir}/summary.txt" ]]; then
  echo
  cat "${run_dir}/summary.txt"
fi

if [[ -s "${run_dir}/final.txt" ]]; then
  echo
  echo "Final answer:"
  cat "${run_dir}/final.txt"
fi

if [[ "$state" == "failed" && -s "${run_dir}/stderr.log" ]]; then
  echo
  echo "stderr (last 30 lines):"
  tail -n 30 "${run_dir}/stderr.log"
fi
