#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LAB="$ROOT/labs/13-evidence-fusion"

if [[ -n "${OPENAI_API_KEY:-}" ]]; then
  echo "refusing to run: OPENAI_API_KEY is set" >&2
  exit 2
fi

python3 "$LAB/scripts/compare-assertions.py" \
  "$LAB/fixtures/comparisons.json" \
  "$LAB/fixtures/predicate-rules.json"

python3 "$LAB/scripts/self-test.py"
python3 "$LAB/scripts/self-test-comparison-record.py"
python3 "$LAB/scripts/self-test-identity-boundary.py"
python3 "$LAB/scripts/self-test-finding-lineage.py"

echo "LAB13_OFFLINE_SELF_TEST_PASS"
