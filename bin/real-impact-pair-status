#!/usr/bin/env bash
set -euo pipefail

order="${1:-AB}"
case "$order" in
  AB|BA) ;;
  *) echo "Usage: $0 [AB|BA]" >&2; exit 2 ;;
esac

latest="/tmp/rubydex-real-impact-pair-${order}-latest"
if [[ ! -e "$latest" ]]; then
  echo "No real impact pair ${order} found." >&2
  exit 1
fi
pair_dir="$(cd "$latest" && pwd)"
state="unknown"
[[ -f "${pair_dir}/state" ]] && state="$(cat "${pair_dir}/state")"

echo "Pair: ${pair_dir}"
echo "State: ${state}"
if [[ -f "${pair_dir}/pid" ]]; then
  pid="$(cat "${pair_dir}/pid")"
  if kill -0 "$pid" >/dev/null 2>&1; then
    echo "PID: ${pid} (running)"
  fi
fi

for label in A B; do
  lower="$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')"
  path_file="${pair_dir}/${lower}-run-dir"
  if [[ -s "$path_file" ]]; then
    run_dir="$(cat "$path_file")"
    run_state="unknown"
    [[ -f "${run_dir}/state" ]] && run_state="$(cat "${run_dir}/state")"
    echo "${label}: ${run_state} - ${run_dir}"
  fi
done

if [[ -s "${pair_dir}/summary.txt" ]]; then
  echo
  cat "${pair_dir}/summary.txt"
fi
if [[ -s "${pair_dir}/comparison.md" ]]; then
  echo
  cat "${pair_dir}/comparison.md"
fi

case "$state" in
  failed_*|blocked_usage_*)
    if [[ -s "${pair_dir}/worker.log" ]]; then
      echo
      echo "worker log (last 60 lines):"
      tail -n 60 "${pair_dir}/worker.log"
    fi
    ;;
esac
