#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LAB_DIR="$ROOT_DIR/labs/12-evidence-set"
FIXTURES="$LAB_DIR/fixtures/evidence-sets.json"
VALIDATOR="$LAB_DIR/scripts/validate-evidence-set.py"
RENDERER="$LAB_DIR/scripts/render-evidence-set.py"
SCORER="$LAB_DIR/scripts/score-rendering.py"
SELF_TEST="$LAB_DIR/scripts/self-test.py"

export NO_PROXY='*'
export no_proxy='*'

if [[ -n "${OPENAI_API_KEY:-}" ]]; then
  echo "refusing to run with OPENAI_API_KEY present; unset it for zero-network Lab 12 self-test" >&2
  exit 2
fi

for command in python3 mktemp; do
  command -v "$command" >/dev/null 2>&1 || {
    echo "missing required command: $command" >&2
    exit 2
  }
done

for path in "$FIXTURES" "$VALIDATOR" "$RENDERER" "$SCORER" "$SELF_TEST"; do
  [[ -f "$path" ]] || {
    echo "missing required Lab 12 file: $path" >&2
    exit 2
  }
done

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

echo "[1/3] validating canonical EvidenceSet fixtures"
python3 "$VALIDATOR" "$FIXTURES"

echo "[2/3] render + exact-score every canonical fixture"
python3 - "$FIXTURES" <<'PY' | while IFS= read -r fixture_id; do
import json
import sys
from pathlib import Path
for row in json.loads(Path(sys.argv[1]).read_text()):
    print(row["id"])
PY
  rendered="$TMP_DIR/${fixture_id}.txt"
  python3 "$RENDERER" "$FIXTURES" "$fixture_id" > "$rendered"
  python3 "$SCORER" "$FIXTURES" "$fixture_id" "$rendered" >/dev/null
  echo "PASS render-score $fixture_id"
done

echo "[3/3] running deliberate-corruption self-test"
python3 "$SELF_TEST" "$FIXTURES"

echo "LAB12_OFFLINE_SELF_TEST_PASS"
