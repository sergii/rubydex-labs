{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rubydex-labs.local/schemas/hypothesis.schema.json",
  "title": "Engineering hypothesis",
  "description": "Explicit candidate explanation evaluated through evidence during investigation; not a hidden reasoning trace or root-cause fact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "claim",
    "status",
    "confidence_record",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "incident_ref": { "type": ["string", "null"] },
    "claim": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["PROPOSED", "INVESTIGATING", "SUPPORTED", "WEAKENED", "REFUTED", "CONFIRMED", "SUPERSEDED"]
    },
    "confidence_record": { "$ref": "confidence.schema.json" },
    "subject_entity_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "supporting_assertion_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "contradicting_assertion_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "supporting_evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "contradicting_evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "verification_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "supersedes": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object" }
  }
}
